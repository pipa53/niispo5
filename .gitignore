# ============================================================
#  Секреты — НИКОГДА не коммитить
# ============================================================
.env
**/.env
*.env.local

# Исключения: шаблоны должны попадать в репо
!.env.example
!**/.env.example

# ============================================================
#  Python
# ============================================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
#  Node.js
# ============================================================
node_modules/
**/node_modules/
npm-debug.log*

# ============================================================
#  Docker
# ============================================================
*.tar
*.tar.gz

# ============================================================
#  IDE
# ============================================================
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
*~
.claude/
**/.claude/

# ============================================================
#  ОС
# ============================================================
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db

# ============================================================
#  Terraform (state и кэш провайдеров — НЕ коммитить;
#  .terraform.lock.hcl — коммитить обязательно)
# ============================================================
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ============================================================
#  Логи и временные файлы
# ============================================================
*.log
**/*.log
tmp/
**/tmp/
# Рабочие дампы и временные файлы для отладки
dump*.txt
tree-*.txt